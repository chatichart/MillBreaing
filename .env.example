NODE_ENV=production
PORT=3000
APP_ORIGIN=https://millbearing.realsoluplus.com
DATABASE_URL=postgresql://USER:PASSWORD@POSTGRES_SERVICE:5432/DATABASE
DATABASE_SSL=false
# Temporary public trial: editor or readonly. Production approval mode: off.
DEMO_MODE=editor
# Only required when DEMO_MODE=off. Generate locally and enter server-side.
SESSION_SECRET=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Comma-separated stable Entra user Object IDs, not email addresses.
ENTRA_ADMIN_OBJECT_IDS=
UPLOAD_DIR=/data/uploads
