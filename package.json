{
  "name": "mill-bearing",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0 <23.0.0 || >=24.0.0 <25.0.0 || >=26.0.0 <27.0.0"
  },
  "scripts": {
    "build": "vite build --mode web && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.mjs",
    "clean": "heft clean",
    "eject-webpack": "heft eject-webpack",
    "start": "node dist-server/server.mjs",
    "test": "vitest run",
    "preview": "vite --mode preview --host 127.0.0.1 --open /preview.html",
    "build:preview": "vite build --mode preview",
    "typecheck": "tsc --noEmit",
    "build:sharepoint": "heft test --clean --production && heft package-solution --production",
    "start:sharepoint": "heft start --clean",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "dev:server": "tsx server/index.ts"
  },
  "dependencies": {
    "@fluentui/react": "^8.106.4",
    "@microsoft/sp-component-base": "1.24.1",
    "@microsoft/sp-core-library": "1.24.1",
    "@microsoft/sp-lodash-subset": "1.24.1",
    "@microsoft/sp-office-ui-fabric-core": "1.24.1",
    "@microsoft/sp-property-pane": "1.24.1",
    "@microsoft/sp-webpart-base": "1.24.1",
    "connect-pg-simple": "^10.0.0",
    "exceljs": "4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "openid-client": "^6.9.0",
    "papaparse": "5.5.3",
    "pg": "^8.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tslib": "2.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@microsoft/eslint-config-spfx": "1.24.1",
    "@microsoft/eslint-plugin-spfx": "1.24.1",
    "@microsoft/sp-module-interfaces": "1.24.1",
    "@microsoft/spfx-heft-plugins": "1.24.1",
    "@microsoft/spfx-web-build-rig": "1.24.1",
    "@rushstack/heft": "1.3.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.19.0",
    "@types/jest": "30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/papaparse": "5.3.16",
    "@types/pg": "^8.23.1",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "@types/supertest": "^7.2.1",
    "@types/webpack-env": "~1.15.2",
    "css-loader": "~7.1.2",
    "embedded-postgres": "^18.6.0-beta.19",
    "esbuild": "^0.28.2",
    "eslint": "9.37.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "jsdom": "26.1.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~5.8.0",
    "vite": "6.4.6",
    "vitest": "4.1.11"
  },
  "overrides": {
